# Frontend API endpoint.
# Local development (use the local ApiCrownStore port):
VITE_API_BASE_URL=http://localhost:4000

# Cloudflare Pages Production environment should use:
# VITE_API_BASE_URL=https://apicrownstore.kingshall.online
# VITE_API_BASE_URL is public frontend configuration, never put private service secrets here.

# ImageKit delivery URL endpoint from your ImageKit dashboard (URL Endpoints).
# Example format: https://ik.imagekit.io/your_imagekit_id
# Set the real value in local .env and Cloudflare Pages environment variables.
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
